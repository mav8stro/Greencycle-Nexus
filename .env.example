# ──────────────────────────────────────────────────────────────────────────────
# GreenCycle Nexus — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application Core ──────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-string-in-production
FLASK_ENV=development
PORT=5000

# Token expiry duration (hours)
TOKEN_EXPIRY_HOURS=48

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite for local development
DATABASE_URL=sqlite:///greencycle.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/greencycle_nexus

# ── Frontend API Base URL ─────────────────────────────────────────────────────
# This allows the same frontend HTML to connect to different backends:
# Local:    http://localhost:5000
# LAN:      http://192.168.1.100:5000
API_BASE_URL=http://localhost:5000

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=GreenCycle Nexus

# ── Payment Gateway ───────────────────────────────────────────────────────────
PAYMENT_GATEWAY_MODE=MOCK_SECURE
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Operational Defaults ─────────────────────────────────────────────────────
DEFAULT_DIESEL_PRICE=94.50
DEFAULT_PETROL_PRICE=105.20
DEFAULT_ELECTRICITY_PRICE=7.50
